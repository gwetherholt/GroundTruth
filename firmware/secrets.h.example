/*
 * GroundTruth — firmware secrets template
 *
 * Copy this file to `secrets.h` in the same directory and fill in your
 * network details:
 *
 *     cp firmware/secrets.h.example firmware/secrets.h
 *
 * `firmware/secrets.h` is gitignored and must stay that way. This
 * repository is public: anything committed here is public forever,
 * because git history keeps a copy even after the file is deleted.
 *
 * If you compile a sketch from its own folder rather than from
 * `firmware/`, copy `secrets.h` next to the `.ino` — the include is
 * resolved relative to the sketch.
 *
 * The MQTT broker address is deliberately NOT here. It is a private
 * LAN address, it is not a credential, and keeping it in the sketch
 * makes the wiring obvious to anyone reading the firmware.
 */

#pragma once

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"
